<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.classguard.mapper.UserMapper">

    <!-- ==================== 头部约定注释（DB V0.3 §6.3 全局约定） ====================
         1) 统一使用 #{} 预编译占位符，动态条件用 <if> 拼接，禁止 ${} 字符串拼接；
         2) 时间范围统一闭区间 [from, to]，且可只传其一；
         3) 排序统一 ORDER BY created_at DESC, id DESC；分页统一 LIMIT #{offset}, #{limit}。
         数据来源：《数据库设计说明书（第8组）》V0.3（已冻结）§4.1/§6.3，
         接口出处：《REST 接口文档 v1.1》。 -->

    <!-- API-02 登录查询（REST v1.1 / DB V0.3 §6.3(1)） -->
    <select id="selectByUsername" resultType="com.example.classguard.entity.User">
        SELECT id, username, password, role
        FROM users
        WHERE username = #{username}
    </select>

    <!-- API-04 当前用户信息（REST v1.1 / DB V0.3 §6.3(1)）：按主键查询 -->
    <select id="selectById" resultType="com.example.classguard.entity.User">
        SELECT id, username, password, role, created_at
        FROM users
        WHERE id = #{id}
    </select>

    <!-- 注册（role=user，used_invite_code 记录所用邀请码，REST v1.2 API-01 / DB V0.4 §6.3(2)）
         与预置管理员（role=admin，used_invite_code 为 NULL）共用：
         显式插入 username/password/role/used_invite_code 四字段，useGeneratedKeys 回填自增主键 id -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, password, role, used_invite_code)
        VALUES (#{username}, #{password}, #{role}, #{usedInviteCode})
    </insert>

    <!-- API-03 修改密码（REST v1.1 / DB V0.3 §6.3(1)）：入参 password 为 BCrypt 哈希后的值 -->
    <update id="updatePassword">
        UPDATE users
        SET password = #{password}
        WHERE id = #{id}
    </update>

</mapper>
